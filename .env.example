APP_ENV=development

# Local dev: file-based SQLite.
# Production (Turso): sqlite+libsql://<db>-<org>.turso.io/?authToken=<token>&secure=true
DATABASE_URL=sqlite:///./db/outreach.db
DB_ECHO=false

# Turso embedded replica (perf — enable on the single-process VM only).
# When set to a writable path AND DATABASE_URL is libsql://, the app keeps a
# local SQLite replica here: reads come from local disk (~1ms vs ~150-250ms
# remote), writes forward to the Turso primary, replica pulls every
# LIBSQL_SYNC_INTERVAL seconds. Empty = disabled (talk to remote directly).
# e.g. LIBSQL_REPLICA_PATH=/var/lib/knock/replica.db
LIBSQL_REPLICA_PATH=
LIBSQL_SYNC_INTERVAL=30

# CORS / cookies — frontend on Vercel/Next.js
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth (Google Cloud Console → Credentials → OAuth 2.0 Client ID, Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Fernet key — generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional integrations
HUNTER_API_KEY=

# Behavior
TIMEZONE=Asia/Kolkata
SEND_HOURS_START=9
SEND_HOURS_END=19
DEFAULT_DAILY_LIMIT=20
HARD_DAILY_CEILING=30
GLOBAL_LOCK_DAYS=2
FOLLOWUP_DELAY_DAYS=4
MAX_FOLLOWUPS=2
SESSION_TTL_DAYS=30

# Operations
LOG_LEVEL=INFO
# Autopilot scheduler. Keep 0 in dev/test (never auto-sends). Set 1 ONLY in the
# single-process prod deployment — fires the autopilot cycle every
# AUTOPILOT_CYCLE_INTERVAL_MINUTES (batch-gen → send-drain → reply-ingest).
RUN_SCHEDULER=0
AUTOPILOT_CYCLE_INTERVAL_MINUTES=30
ADMIN_EMAILS=
